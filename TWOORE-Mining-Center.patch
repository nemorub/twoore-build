+namespace {
+constexpr int REFRESH_MS = 3000;
+constexpr int API_TIMEOUT_MS = 5000;
+const QString GOOD = QStringLiteral("#35c46a");
+const QString WARN = QStringLiteral("#e6ad2f");
+const QString BAD = QStringLiteral("#e05252");
+const QString MUTED = QStringLiteral("#8899a6");
+
+QString homePath(const QString& relative)
+{
+    return QDir::home().filePath(relative);
+}
+
+QString normalizedIp(const QString& addr)
+{
+    QString out = addr;
+    if (out.startsWith('[')) {
+        const int close = out.indexOf(']');
+        if (close > 0) return out.mid(1, close - 1);
+    }
+    const int colon = out.lastIndexOf(':');
+    if (colon > 0) out = out.left(colon);
+    return out;
+}
+}
+
+MiningCenter::MiningCenter(interfaces::Node& node, QWidget* parent)
+    : QDialog(parent), m_node(node)
+{
+    setWindowTitle(tr("TWOORE Mining Center"));
+    resize(940, 760);
+    setModal(false);
+
+    m_network = new QNetworkAccessManager(this);
+    m_refresh_timer = new QTimer(this);
+    m_refresh_timer->setInterval(REFRESH_MS);
+    connect(m_refresh_timer, &QTimer::timeout, this, &MiningCenter::refreshAll);
+
+    auto* root = new QVBoxLayout(this);
+
+    auto* title = new QLabel(tr("TWOORE CONTROL CENTER — NODE · CKPOOL · BITAXE"), this);
+    QFont title_font = title->font();
+    title_font.setPointSize(title_font.pointSize() + 4);
+    title_font.setBold(true);
+    title->setFont(title_font);
+    root->addWidget(title);
+
+    auto* network_box = new QGroupBox(tr("Network safety"), this);
+    auto* network_form = new QFormLayout(network_box);
+    m_node_state = new QLabel(network_box);
+    m_blocks = new QLabel(network_box);
+    m_headers = new QLabel(network_box);
+    m_best_hash = new QLabel(network_box);
+    m_best_hash->setTextInteractionFlags(Qt::TextSelectableByMouse);
+    m_ibd = new QLabel(network_box);
+    m_connections = new QLabel(network_box);
+    m_peer_consensus = new QLabel(network_box);
+    m_api_state = new QLabel(network_box);
+    m_safety_state = new QLabel(network_box);
+    network_form->addRow(tr("Node:"), m_node_state);
+    network_form->addRow(tr("Blocks:"), m_blocks);
+    network_form->addRow(tr("Headers:"), m_headers);
+    network_form->addRow(tr("Best block:"), m_best_hash);
+    network_form->addRow(tr("IBD:"), m_ibd);
+    network_form->addRow(tr("Connections:"), m_connections);
+    network_form->addRow(tr("Trusted peers:"), m_peer_consensus);
+    network_form->addRow(tr("Public API:"), m_api_state);
+    network_form->addRow(tr("Safe to mine:"), m_safety_state);
+
+    auto* network_buttons = new QHBoxLayout();
+    auto* refresh_button = new QPushButton(tr("Refresh"), network_box);
+    auto* reconnect_button = new QPushButton(tr("Reconnect trusted peers"), network_box);
+    auto* repair_button = new QPushButton(tr("Repair / resync safely"), network_box);
+    network_buttons->addWidget(refresh_button);
+    network_buttons->addWidget(reconnect_button);
+    network_buttons->addWidget(repair_button);
+    network_form->addRow(network_buttons);
+
+    connect(refresh_button, &QPushButton::clicked, this, &MiningCenter::refreshAll);
+    connect(reconnect_button, &QPushButton::clicked, this, &MiningCenter::reconnectTrustedPeers);
+    connect(repair_button, &QPushButton::clicked, this, &MiningCenter::repairNetwork);
+
+    m_auto_heal = new QCheckBox(tr("Auto-heal: stop mining and safely roll back when 3 trusted peers + API confirm a divergence"), network_box);
+    m_auto_heal->setChecked(true);
+    m_auto_resume_pool = new QCheckBox(tr("Auto-resume CKPool after the new public tip is confirmed"), network_box);
+    m_auto_resume_pool->setChecked(false);
+    network_form->addRow(m_auto_heal);
+    network_form->addRow(m_auto_resume_pool);
+    root->addWidget(network_box);
+
+    auto* pool_box = new QGroupBox(tr("CKPool / Stratum"), this);
+    auto* pool_form = new QFormLayout(pool_box);
+    m_ckpool_path = new QLineEdit(homePath(QStringLiteral("ckpool-twoore/src/ckpool")), pool_box);
+    m_ckpool_conf = new QLineEdit(homePath(QStringLiteral("ckpool-twoore/ckpool-twoore.conf")), pool_box);
+    m_stratum_host = new QLineEdit(defaultStratumHost(), pool_box);
+    m_pool_state = new QLabel(pool_box);
+    m_stratum_state = new QLabel(pool_box);
+    pool_form->addRow(tr("CKPool binary:"), m_ckpool_path);
+    pool_form->addRow(tr("CKPool config:"), m_ckpool_conf);
+    pool_form->addRow(tr("Stratum host visible to Bitaxe:"), m_stratum_host);
+    pool_form->addRow(tr("CKPool:"), m_pool_state);
+    pool_form->addRow(tr("Port 3333:"), m_stratum_state);
+
+    auto* pool_buttons = new QHBoxLayout();
+    m_start_pool_button = new QPushButton(tr("START MINING"), pool_box);
+    auto* stop_pool_button = new QPushButton(tr("STOP CKPOOL"), pool_box);
+    auto* bridge_button = new QPushButton(tr("Windows bridge :3333"), pool_box);
+    pool_buttons->addWidget(m_start_pool_button);
+    pool_buttons->addWidget(stop_pool_button);
+    if (runningInWSL()) pool_buttons->addWidget(bridge_button);
+    else bridge_button->hide();
+    pool_form->addRow(pool_buttons);
+    connect(m_start_pool_button, &QPushButton::clicked, this, &MiningCenter::startPool);
+    connect(stop_pool_button, &QPushButton::clicked, this, &MiningCenter::stopPool);
+    connect(bridge_button, &QPushButton::clicked, this, &MiningCenter::configureWindowsBridge);
+    root->addWidget(pool_box);
+
+    auto* bitaxe_box = new QGroupBox(tr("Bitaxe"), this);
+    auto* bitaxe_layout = new QVBoxLayout(bitaxe_box);
+
+    auto create_bitaxe_row = [this, bitaxe_layout](const QString& label_text, QLineEdit*& ip, QLabel*& state, auto refresh_slot, auto config_slot) {
+        auto* row = new QHBoxLayout();
+        auto* name = new QLabel(label_text, this);
+        name->setMinimumWidth(75);
+        ip = new QLineEdit(this);
+        ip->setPlaceholderText(tr("192.168.50.x"));
+        state = new QLabel(tr("Not checked"), this);
+        state->setMinimumWidth(330);
+        auto* refresh = new QPushButton(tr("Read"), this);
+        auto* configure = new QPushButton(tr("Link to TWOORE"), this);
+        row->addWidget(name);
+        row->addWidget(ip);
+        row->addWidget(state, 1);
+        row->addWidget(refresh);
+        row->addWidget(configure);
+        bitaxe_layout->addLayout(row);
+        connect(refresh, &QPushButton::clicked, this, refresh_slot);
+        connect(configure, &QPushButton::clicked, this, config_slot);
+    };
+
+    create_bitaxe_row(tr("Bitaxe 1"), m_bitaxe1_ip, m_bitaxe1_state, &MiningCenter::refreshBitaxe1, &MiningCenter::configureBitaxe1);
+    create_bitaxe_row(tr("Bitaxe 2"), m_bitaxe2_ip, m_bitaxe2_state, &MiningCenter::refreshBitaxe2, &MiningCenter::configureBitaxe2);
+
+    QSettings saved;
+    m_bitaxe1_ip->setText(saved.value(QStringLiteral("MiningCenter/bitaxe1")).toString());
+    m_bitaxe2_ip->setText(saved.value(QStringLiteral("MiningCenter/bitaxe2")).toString());
+    const QString saved_host = saved.value(QStringLiteral("MiningCenter/stratumHost")).toString();
+    if (!saved_host.isEmpty()) m_stratum_host->setText(saved_host);
+
+    auto* miner_buttons = new QHBoxLayout();
+    auto* pause_button = new QPushButton(tr("Pause both Bitaxe"), bitaxe_box);
+    auto* resume_button = new QPushButton(tr("Resume both Bitaxe"), bitaxe_box);
+    miner_buttons->addWidget(pause_button);
+    miner_buttons->addWidget(resume_button);
+    bitaxe_layout->addLayout(miner_buttons);
+    connect(pause_button, &QPushButton::clicked, this, &MiningCenter::pauseBitaxes);
+    connect(resume_button, &QPushButton::clicked, this, &MiningCenter::resumeBitaxes);
+    root->addWidget(bitaxe_box);
+
+    m_log = new QTextEdit(this);
+    m_log->setReadOnly(true);
+    m_log->setMinimumHeight(120);
+    root->addWidget(m_log, 1);
+
+    appendLog(tr("Mining Center ready. CKPool is gated by public-network checks."));
+    m_refresh_timer->start();
+    QTimer::singleShot(250, this, &MiningCenter::refreshAll);
+}
