diff -ruN twoore-pristine/twoore-chain-main/TWOORE-DESKTOP-MINING-CENTER.md twoore-final/twoore-chain-main/TWOORE-DESKTOP-MINING-CENTER.md
--- twoore-pristine/twoore-chain-main/TWOORE-DESKTOP-MINING-CENTER.md	1970-01-01 00:00:00.000000000 +0000
+++ twoore-final/twoore-chain-main/TWOORE-DESKTOP-MINING-CENTER.md	2026-10-04 21:33:57.125882544 +0000
@@ -0,0 +1,102 @@
+# TWOORE Desktop + Mining Center
+
+This source tree adds a native Qt **Mining Center** to the TWOORE desktop node.
+It is designed for the current setup where the node, CKPool and chain data live
+inside Ubuntu/WSL while the user works from Windows.
+
+## Why build the Linux GUI in Ubuntu/WSL
+
+Running the Qt GUI inside WSLg avoids a fragile RPC bridge between a Windows
+node and a Linux CKPool. The GUI is still shown on the Windows desktop, but the
+node and CKPool share `127.0.0.1`, the same filesystem and the same TWOORE
+configuration.
+
+## Added features
+
+The toolbar has a new **Mining Center** button (Alt+5). It provides:
+
+- local block height, header height, best block hash and IBD state;
+- trusted TWOORE peer consensus checks;
+- public API/hash verification;
+- a hard safety gate: CKPool cannot start when the public tip is not confirmed;
+- CKPool configuration repair and start/stop control;
+- automatic CKPool shutdown when a newly mined block appears;
+- Bitaxe 1 / Bitaxe 2 monitoring through AxeOS `/api/system/info`;
+- one-click Bitaxe configuration through AxeOS `PATCH /api/system`;
+- Bitaxe pause/resume controls;
+- safe rollback only when 3 trusted peers and the TWOORE API confirm the common
+  public point;
+- a fresh peer-handshake check 15 seconds after a mined block and a 30-second
+  propagation grace period before a still-unconfirmed local block is eligible
+  for automatic rollback;
+- WSL detection and a Windows port-3333 bridge button. It requests UAC and
+  configures Windows `netsh portproxy` so LAN Bitaxe devices can reach CKPool
+  running inside WSL.
+
+## Live-chain compatibility
+
+`src/pow.cpp` contains the same live-chain compatibility rule used for the
+current public TWOORE chain: from height 10003 the proof-of-work target is the
+network powLimit. This is required to follow the current live chain that was
+observed through height 10722.
+
+## Build on Ubuntu / WSL
+
+From the source folder:
+
+```bash
+chmod +x build-twoore-desktop-ubuntu.sh
+./build-twoore-desktop-ubuntu.sh --install-deps
+```
+
+The build output is placed in:
+
+```text
+dist/twoore-desktop
+dist/twoored
+dist/twoore-cli
+dist/run-twoore-desktop.sh
+```
+
+Start it with:
+
+```bash
+./dist/run-twoore-desktop.sh
+```
+
+The launcher deliberately adds `-txindex=0` because the existing txindex in the
+current datadir was inconsistent after the previous restart and is not required
+for Bitaxe mining.
+
+## Windows + WSLg
+
+If Ubuntu is running under WSLg, `twoore-desktop` appears as a normal graphical
+window on Windows. Keep CKPool at:
+
+```text
+~/ckpool-twoore/src/ckpool
+~/ckpool-twoore/ckpool-twoore.conf
+```
+
+Inside Mining Center:
+
+1. Wait until blocks == headers and the public tip is green.
+2. Set each Bitaxe IP.
+3. The `Stratum host visible to Bitaxe` field should normally auto-detect the
+   Windows LAN IP (for example 192.168.50.x).
+4. Press **Windows bridge :3333** once after each WSL IP change. Windows will
+   request administrator approval.
+5. Press **Link to TWOORE** for each Bitaxe.
+6. Press **START MINING** only when the safety status is green.
+
+When a new block is detected, CKPool is stopped and the Bitaxe devices are
+paused while propagation is checked. The application does not assume that the
+peer `startingheight` value updates after accepting a block; public API hash
+confirmation is used for post-mining verification.
+
+## Important
+
+The Mining Center can prevent long private forks and repair a known local
+branch safely. It cannot force a remote TWOORE node to accept a header that the
+remote node considers invalid. In that case it stops mining and protects the
+local node instead of silently extending a private chain.
diff -ruN twoore-pristine/twoore-chain-main/build-twoore-desktop-ubuntu.sh twoore-final/twoore-chain-main/build-twoore-desktop-ubuntu.sh
--- twoore-pristine/twoore-chain-main/build-twoore-desktop-ubuntu.sh	1970-01-01 00:00:00.000000000 +0000
+++ twoore-final/twoore-chain-main/build-twoore-desktop-ubuntu.sh	2026-10-04 21:33:57.125733054 +0000
@@ -0,0 +1,91 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+ROOT="$(cd "$(dirname "$0")" && pwd)"
+cd "$ROOT"
+
+if [[ "$ROOT" == /mnt/* ]]; then
+  echo "WARNING: You are building from a Windows-mounted path ($ROOT)."
+  echo "For WSL, move the source under your Linux home directory first, e.g.:"
+  echo "  cp -a '$ROOT' ~/twoore-desktop-source"
+  echo "Then build from ~/twoore-desktop-source for better reliability and speed."
+  echo
+fi
+
+INSTALL_DEPS=0
+if [[ "${1:-}" == "--install-deps" ]]; then
+  INSTALL_DEPS=1
+fi
+
+if [[ $INSTALL_DEPS -eq 1 ]]; then
+  echo "[1/5] Installing Ubuntu build dependencies..."
+  sudo apt update
+  sudo apt install -y \
+    build-essential libtool autotools-dev automake pkg-config bsdextrautils \
+    python3 libevent-dev libboost-dev libsqlite3-dev libzmq3-dev \
+    qtbase5-dev qttools5-dev qttools5-dev-tools qtwayland5 libqrencode-dev
+else
+  echo "[1/5] Dependency installation skipped."
+  echo "      Re-run with --install-deps if configure reports missing packages."
+fi
+
+echo "[2/5] Regenerating Autotools files..."
+./autogen.sh
+
+echo "[3/5] Configuring TWOORE Desktop + Mining Center..."
+./configure \
+  --with-gui=qt5 \
+  --with-sqlite=yes \
+  --without-bdb \
+  --enable-zmq \
+  --disable-tests \
+  --disable-bench \
+  CXXFLAGS="${CXXFLAGS:--O2}"
+
+echo "[4/5] Building with $(nproc) jobs..."
+make -j"$(nproc)"
+
+echo "[5/5] Preparing dist/ ..."
+mkdir -p dist
+cp -f src/qt/bitcoin-qt dist/twoore-desktop
+cp -f src/twoored dist/twoored
+cp -f src/twoore-cli dist/twoore-cli
+chmod +x dist/twoore-desktop dist/twoored dist/twoore-cli
+
+cat > dist/run-twoore-desktop.sh <<'RUNEOF'
+#!/usr/bin/env bash
+set -euo pipefail
+ROOT="$(cd "$(dirname "$0")" && pwd)"
+DATADIR="${TWOORE_DATADIR:-$HOME/twoore-mainnet}"
+CONF="${TWOORE_CONF:-$DATADIR/twoore.conf}"
+
+if pgrep -x twoored >/dev/null 2>&1; then
+  echo "A separate twoored process is already running."
+  echo "Stop it first so the GUI can own the datadir safely."
+  exit 1
+fi
+
+exec "$ROOT/twoore-desktop" \
+  -datadir="$DATADIR" \
+  -conf="$CONF" \
+  -txindex=0
+RUNEOF
+chmod +x dist/run-twoore-desktop.sh
+
+cat <<MSG
+
+============================================================
+ TWOORE Desktop build completed
+============================================================
+GUI:       $ROOT/dist/twoore-desktop
+Launcher:  $ROOT/dist/run-twoore-desktop.sh
+Daemon:    $ROOT/dist/twoored
+CLI:       $ROOT/dist/twoore-cli
+
+Run:
+  ./dist/run-twoore-desktop.sh
+
+If you are inside Windows WSL with WSLg, the Linux GUI will appear as a
+normal desktop window on Windows while CKPool stays inside Ubuntu.
+============================================================
+MSG
diff -ruN twoore-pristine/twoore-chain-main/install-twoore-desktop-shortcut.sh twoore-final/twoore-chain-main/install-twoore-desktop-shortcut.sh
--- twoore-pristine/twoore-chain-main/install-twoore-desktop-shortcut.sh	1970-01-01 00:00:00.000000000 +0000
+++ twoore-final/twoore-chain-main/install-twoore-desktop-shortcut.sh	2026-10-04 21:32:08.844218646 +0000
@@ -0,0 +1,25 @@
+#!/usr/bin/env bash
+set -euo pipefail
+ROOT="$(cd "$(dirname "$0")" && pwd)"
+APP="$ROOT/dist/run-twoore-desktop.sh"
+
+if [[ ! -x "$APP" ]]; then
+  echo "Build the application first with ./build-twoore-desktop-ubuntu.sh"
+  exit 1
+fi
+
+mkdir -p "$HOME/.local/share/applications"
+DESKTOP="$HOME/.local/share/applications/twoore-desktop.desktop"
+cat > "$DESKTOP" <<EOF2
+[Desktop Entry]
+Type=Application
+Name=TWOORE Desktop
+Comment=TWOORE wallet, node, CKPool and Bitaxe Mining Center
+Exec=$APP
+Terminal=false
+Categories=Network;Finance;
+StartupNotify=true
+EOF2
+chmod +x "$DESKTOP"
+echo "Installed: $DESKTOP"
+echo "Under WSLg it should also appear in the Windows Start menu under your Ubuntu apps."
