+void MiningCenter::setStateLabel(QLabel* label, const QString& text, const QString& color)
+{
+    if (!label) return;
+    label->setText(text);
+    label->setStyleSheet(QStringLiteral("QLabel { color: %1; font-weight: 600; }").arg(color));
+}
+
+bool MiningCenter::runningInWSL() const
+{
+    if (qEnvironmentVariableIsSet("WSL_DISTRO_NAME")) return true;
+    QFile f(QStringLiteral("/proc/version"));
+    if (f.open(QIODevice::ReadOnly)) {
+        return QString::fromUtf8(f.readAll()).contains(QStringLiteral("microsoft"), Qt::CaseInsensitive);
+    }
+    return false;
+}
+
+QString MiningCenter::wslIp() const
+{
+    QProcess p;
+    p.start(QStringLiteral("hostname"), {QStringLiteral("-I")});
+    if (!p.waitForFinished(1500)) return {};
+    const QStringList ips = QString::fromUtf8(p.readAllStandardOutput()).simplified().split(' ', Qt::SkipEmptyParts);
+    for (const QString& ip : ips) {
+        QHostAddress addr(ip);
+        if (addr.protocol() == QAbstractSocket::IPv4Protocol && !addr.isLoopback()) return ip;
+    }
+    return {};
+}
+
+QString MiningCenter::defaultStratumHost() const
+{
+    // In WSL, the Bitaxe must normally connect to the Windows LAN address,
+    // not the private WSL 172.x address. Ask Windows for the best physical IPv4.
+    if (runningInWSL()) {
+        QProcess ps;
+        const QString command = QStringLiteral(
+            "(Get-NetIPAddress -AddressFamily IPv4 | Where-Object { $_.IPAddress -notlike '127.*' -and $_.IPAddress -notlike '169.254*' -and $_.InterfaceAlias -notmatch 'vEthernet|WSL|Loopback|Bluetooth' } | Sort-Object InterfaceMetric | Select-Object -First 1 -ExpandProperty IPAddress)");
+        ps.start(QStringLiteral("powershell.exe"), {QStringLiteral("-NoProfile"), QStringLiteral("-Command"), command});
+        if (ps.waitForFinished(2500)) {
+            const QString ip = QString::fromUtf8(ps.readAllStandardOutput()).trimmed();
+            QHostAddress addr(ip);
+            if (addr.protocol() == QAbstractSocket::IPv4Protocol) return ip;
+        }
+    }
+
+    QString fallback;
+    const auto addresses = QNetworkInterface::allAddresses();
+    for (const QHostAddress& addr : addresses) {
+        if (addr.protocol() != QAbstractSocket::IPv4Protocol || addr.isLoopback()) continue;
+        const QString s = addr.toString();
+        if (fallback.isEmpty()) fallback = s;
+        if (s.startsWith(QStringLiteral("192.168.")) || s.startsWith(QStringLiteral("10."))) return s;
+    }
+    return fallback;
+}
+
+void MiningCenter::configureWindowsBridge()
+{
+    if (!runningInWSL()) {
+        QMessageBox::information(this, tr("TWOORE"), tr("The Windows bridge is only needed when the application is running inside WSL."));
+        return;
+    }
+    const QString linux_ip = wslIp();
+    if (linux_ip.isEmpty()) {
+        QMessageBox::critical(this, tr("TWOORE"), tr("Could not determine the WSL IPv4 address."));
+        return;
+    }
+    const QString lan_ip = m_stratum_host->text().trimmed();
+    if (lan_ip.isEmpty()) {
+        QMessageBox::warning(this, tr("TWOORE"), tr("Set the Windows LAN address visible to the Bitaxe first."));
+        return;
+    }
+
+    const QString script = QStringLiteral(
+        "$ErrorActionPreference='Stop'; "
+        "netsh interface portproxy delete v4tov4 listenport=3333 listenaddress=0.0.0.0 2>$null; "
+        "netsh interface portproxy add v4tov4 listenport=3333 listenaddress=0.0.0.0 connectport=3333 connectaddress=%1; "
+        "netsh advfirewall firewall delete rule name='TWOORE CKPool 3333' 2>$null; "
+        "netsh advfirewall firewall add rule name='TWOORE CKPool 3333' dir=in action=allow protocol=TCP localport=3333; "
+        "Write-Host 'TWOORE bridge ready: %2:3333 -> %1:3333';")
+        .arg(linux_ip, lan_ip);
+
+    const QByteArray utf16(reinterpret_cast<const char*>(script.utf16()), script.size() * 2);
+    const QString encoded = QString::fromLatin1(utf16.toBase64());
+    const QString elevate = QStringLiteral(
+        "Start-Process powershell.exe -Verb RunAs -Wait -ArgumentList '-NoProfile','-EncodedCommand','%1'").arg(encoded);
+
+    appendLog(tr("Requesting Windows administrator permission to map %1:3333 to WSL %2:3333...").arg(lan_ip, linux_ip));
+    QProcess ps;
+    ps.start(QStringLiteral("powershell.exe"), {QStringLiteral("-NoProfile"), QStringLiteral("-Command"), elevate});
+    if (!ps.waitForFinished(60000) || ps.exitCode() != 0) {
+        QMessageBox::warning(this, tr("TWOORE"), tr("Windows bridge setup did not complete. Approve the UAC prompt and try again."));
+        appendLog(tr("Windows portproxy setup failed or was cancelled."));
+        return;
+    }
+    QMessageBox::information(this, tr("TWOORE"), tr("Windows port 3333 is now forwarded to CKPool in WSL. Configure the Bitaxe to %1:3333.").arg(lan_ip));
+    appendLog(tr("Windows bridge ready: %1:3333 -> %2:3333").arg(lan_ip, linux_ip));
+}
