+void MiningCenter::setClientModel(ClientModel* model)
+{
+    if (m_client_model == model) return;
+    if (m_client_model) disconnect(m_client_model, nullptr, this, nullptr);
+    m_client_model = model;
+    if (m_client_model) {
+        connect(m_client_model, &ClientModel::numBlocksChanged, this,
+            [this](int count, const QDateTime&, double, SyncType synctype, SynchronizationState) {
+                if (synctype == SyncType::BLOCK_SYNC) onBlockTipChanged(count);
+            });
+    }
+    refreshAll();
+}
+
+UniValue MiningCenter::rpc(const std::string& command, const UniValue& params, bool* ok, QString* error)
+{
+    try {
+        UniValue result = m_node.executeRpc(command, params, "/");
+        if (ok) *ok = true;
+        if (error) error->clear();
+        return result;
+    } catch (const UniValue& e) {
+        if (ok) *ok = false;
+        if (error) {
+            const UniValue& message = e.find_value("message");
+            *error = message.isStr() ? QString::fromStdString(message.get_str()) : QString::fromStdString(e.write());
+        }
+    } catch (const std::exception& e) {
+        if (ok) *ok = false;
+        if (error) *error = QString::fromUtf8(e.what());
+    } catch (...) {
+        if (ok) *ok = false;
+        if (error) *error = tr("Unknown RPC error");
+    }
+    return UniValue();
+}
+
+void MiningCenter::refreshAll()
+{
+    updateNodeAndPeers();
+    updateSafety();
+    updateApiAsync();
+
+    const bool running = isPoolRunning();
+    setStateLabel(m_pool_state, running ? tr("RUNNING") : tr("STOPPED"), running ? GOOD : MUTED);
+    const bool port_open = stratumPortOpen();
+    setStateLabel(m_stratum_state, port_open ? tr("OPEN") : tr("CLOSED"), port_open ? GOOD : MUTED);
+    m_start_pool_button->setEnabled(m_safe && !running);
+
+    // Automatic protection: a private/local extension immediately stops mining.
+    if (running && m_peer_height >= 0 && m_local_blocks > m_peer_height && m_peer_agree >= 2) {
+        appendLog(tr("Local tip moved ahead of trusted peers. CKPool stopped for propagation verification."));
+        stopPool();
+        m_pool_was_auto_stopped = true;
+    }
+
+    const qint64 now_ms = QDateTime::currentMSecsSinceEpoch();
+    if (m_pending_mined_height >= 0 && m_pending_since_ms > 0
+        && !m_pending_peers_refreshed && (now_ms - m_pending_since_ms) > 15000) {
+        m_pending_peers_refreshed = true;
+        appendLog(tr("Refreshing trusted peers to obtain a new post-mining startingheight handshake."));
+        reconnectTrustedPeers();
+        return;
+    }
+
+    bool allow_auto_rollback = false;
+    if (m_pending_mined_height >= 0) {
+        // Give the explorer/API time to index a freshly mined block. If the
+        // trusted nodes fall back to the previous public tip and the API still
+        // does not know our block after one minute, the strict rollback checks
+        // below may run.
+        allow_auto_rollback = m_pending_since_ms > 0 && m_pending_peers_refreshed
+            && (now_ms - m_pending_since_ms) > 30000 && m_api_code == 404;
+    } else {
+        // Startup/recovery case: a pre-existing local branch can be repaired
+        // without the post-mining grace period.
+        allow_auto_rollback = true;
+    }
+
+    if (m_auto_heal->isChecked() && allow_auto_rollback && !running
+        && m_local_blocks > m_peer_height && m_peer_height >= 0 && m_peer_agree >= 3
+        && now_ms - m_last_auto_heal_attempt > 30000) {
+        m_last_auto_heal_attempt = now_ms;
+        QString error;
+        if (safeRollbackToPublic(&error)) {
+            appendLog(tr("Auto-heal returned the node to the public common tip."));
+            m_pending_mined_height = -1;
+            m_pending_since_ms = 0;
+            m_pending_peers_refreshed = false;
+            refreshAll();
+            return;
+        }
+        if (!error.isEmpty()) appendLog(tr("Auto-heal held: %1").arg(error));
+    }
+
+    if (m_auto_resume_pool->isChecked() && m_pool_was_auto_stopped && m_safe && !isPoolRunning()) {
+        m_pool_was_auto_stopped = false;
+        appendLog(tr("Public tip confirmed again; auto-resuming CKPool."));
+        startPool();
+    }
+}
+
+void MiningCenter::updateNodeAndPeers()
+{
+    bool ok = false;
+    QString error;
+    UniValue empty(UniValue::VARR);
+    const UniValue info = rpc("getblockchaininfo", empty, &ok, &error);
+    if (!ok || !info.isObject()) {
+        setStateLabel(m_node_state, tr("RPC ERROR"), BAD);
+        appendLog(tr("getblockchaininfo failed: %1").arg(error));
+        return;
+    }
+
+    m_local_blocks = info.find_value("blocks").getInt<int>();
+    m_local_headers = info.find_value("headers").getInt<int>();
+    m_local_hash = QString::fromStdString(info.find_value("bestblockhash").get_str());
+    m_ibd_state = info.find_value("initialblockdownload").get_bool();
+
+    setStateLabel(m_node_state, tr("ONLINE"), GOOD);
+    m_blocks->setText(QString::number(m_local_blocks));
+    m_headers->setText(QString::number(m_local_headers));
+    m_best_hash->setText(m_local_hash);
+    setStateLabel(m_ibd, m_ibd_state ? tr("YES") : tr("NO"), m_ibd_state ? WARN : GOOD);
+    m_connections->setText(QString::number(static_cast<qulonglong>(m_node.getNodeCount(ConnectionDirection::Both))));
+
+    const UniValue peers = rpc("getpeerinfo", empty, &ok, &error);
+    std::map<int, int> heights;
+    m_trusted_connected = 0;
+    if (ok && peers.isArray()) {
+        for (const UniValue& p : peers.getValues()) {
+            if (!p.isObject()) continue;
+            const UniValue& addr_v = p.find_value("addr");
+            const UniValue& subver_v = p.find_value("subver");
+            const UniValue& height_v = p.find_value("startingheight");
+            if (!addr_v.isStr() || !height_v.isNum()) continue;
+            const QString addr = QString::fromStdString(addr_v.get_str());
+            const QString ip = normalizedIp(addr);
+            bool trusted = false;
+            for (const QString& candidate : m_trusted_peers) {
+                if (normalizedIp(candidate) == ip) {
+                    trusted = true;
+                    break;
+                }
+            }
+            if (!trusted) continue;
+            if (subver_v.isStr() && !QString::fromStdString(subver_v.get_str()).contains(QStringLiteral("Twoore"), Qt::CaseInsensitive)) continue;
+            const int h = height_v.getInt<int>();
+            if (h >= 0) {
+                ++m_trusted_connected;
+                ++heights[h];
+            }
+        }
+    }
+
+    m_peer_height = -1;
+    m_peer_agree = 0;
+    for (const auto& [height, count] : heights) {
+        if (count > m_peer_agree) {
+            m_peer_height = height;
+            m_peer_agree = count;
+        }
+    }
+
+    if (m_peer_height >= 0) {
+        m_peer_consensus->setText(tr("%1/%2 agree at height %3")
+            .arg(m_peer_agree).arg(m_trusted_connected).arg(m_peer_height));
+    } else {
+        m_peer_consensus->setText(tr("No trusted consensus"));
+    }
+}
+
+void MiningCenter::updateSafety()
+{
+    const bool chain_synced = m_local_blocks >= 0 && m_local_blocks == m_local_headers && !m_ibd_state;
+    const bool api_match = m_api_code == 200 && (m_api_hash.isEmpty() || m_api_hash == m_local_hash);
+    const bool peers_match_handshake_tip = m_peer_height == m_local_blocks && m_peer_agree >= 3;
+
+    // startingheight in getpeerinfo is a handshake value and does not advance after
+    // a peer accepts our new block. Therefore API confirmation is authoritative
+    // after mining; peer startingheight is used mainly to establish the common tip
+    // before mining and during recovery.
+    const bool public_confirmed = api_match || peers_match_handshake_tip;
+    const bool peer_presence = m_trusted_connected >= 1;
+    m_safe = chain_synced && public_confirmed && peer_presence;
+
+    if (m_safe) {
+        setStateLabel(m_safety_state, tr("YES — PUBLIC TIP CONFIRMED"), GOOD);
+        m_last_safe_height = m_local_blocks;
+        if (m_pending_mined_height == m_local_blocks && api_match) {
+            appendLog(tr("Mined block %1 is now confirmed by the public API.").arg(m_local_blocks));
+            m_pending_mined_height = -1;
+            m_pending_since_ms = 0;
+            m_pending_peers_refreshed = false;
+        }
+    } else if (m_pending_mined_height >= 0) {
+        setStateLabel(m_safety_state, tr("WAIT — VERIFYING NEW BLOCK PROPAGATION"), WARN);
+    } else if (m_local_blocks > m_peer_height && m_peer_height >= 0) {
+        setStateLabel(m_safety_state, tr("NO — LOCAL CHAIN AHEAD"), BAD);
+    } else if (!chain_synced) {
+        setStateLabel(m_safety_state, tr("NO — SYNCHRONIZING"), WARN);
+    } else {
+        setStateLabel(m_safety_state, tr("NO — WAITING FOR PUBLIC CONFIRMATION"), WARN);
+    }
+}
+
+void MiningCenter::updateApiAsync()
+{
+    if (m_refreshing_api || m_local_blocks < 0) return;
+    m_refreshing_api = true;
+    const int requested_height = m_local_blocks;
+    const QString requested_hash = m_local_hash;
+    QNetworkRequest req(QUrl(QStringLiteral("https://api.twoore.org/api/block/%1").arg(requested_height)));
+    req.setHeader(QNetworkRequest::UserAgentHeader, QStringLiteral("TWOORE-MiningCenter/1.0"));
+    QNetworkReply* reply = m_network->get(req);
+    QTimer::singleShot(API_TIMEOUT_MS, reply, [reply] {
+        if (!reply->isFinished()) reply->abort();
+    });
+    connect(reply, &QNetworkReply::finished, this, [this, reply, requested_height, requested_hash] {
+        m_refreshing_api = false;
+        const QVariant status = reply->attribute(QNetworkRequest::HttpStatusCodeAttribute);
+        m_api_code = status.isValid() ? status.toInt() : 0;
+        m_api_hash.clear();
+        if (m_api_code == 200) {
+            const QJsonDocument doc = QJsonDocument::fromJson(reply->readAll());
+            if (!doc.isNull()) m_api_hash = extractHash(doc.isObject() ? QJsonValue(doc.object()) : QJsonValue(doc.array()));
+            if (requested_height == m_local_blocks) {
+                if (!m_api_hash.isEmpty() && m_api_hash == requested_hash) {
+                    setStateLabel(m_api_state, tr("HTTP 200 — HASH MATCH"), GOOD);
+                } else if (m_api_hash.isEmpty()) {
+                    setStateLabel(m_api_state, tr("HTTP 200"), GOOD);
+                } else {
+                    setStateLabel(m_api_state, tr("HTTP 200 — HASH MISMATCH"), BAD);
+                }
+            }
+        } else if (m_api_code == 404) {
+            setStateLabel(m_api_state, tr("HTTP 404 — height not public"), WARN);
+        } else {
+            setStateLabel(m_api_state, tr("Unavailable (%1)").arg(m_api_code), WARN);
+        }
+        reply->deleteLater();
+        updateSafety();
+    });
+}
+
+bool MiningCenter::fetchApiBlockSync(int height, int& status_code, QString& hash)
+{
+    hash.clear();
+    QNetworkRequest req(QUrl(QStringLiteral("https://api.twoore.org/api/block/%1").arg(height)));
+    req.setHeader(QNetworkRequest::UserAgentHeader, QStringLiteral("TWOORE-MiningCenter/1.0"));
+    QNetworkReply* reply = m_network->get(req);
+    QEventLoop loop;
+    QTimer timeout;
+    timeout.setSingleShot(true);
+    connect(&timeout, &QTimer::timeout, &loop, &QEventLoop::quit);
+    connect(reply, &QNetworkReply::finished, &loop, &QEventLoop::quit);
+    timeout.start(API_TIMEOUT_MS);
+    loop.exec();
+    if (!reply->isFinished()) reply->abort();
+    const QVariant status = reply->attribute(QNetworkRequest::HttpStatusCodeAttribute);
+    status_code = status.isValid() ? status.toInt() : 0;
+    if (status_code == 200) {
+        const QJsonDocument doc = QJsonDocument::fromJson(reply->readAll());
+        if (!doc.isNull()) hash = extractHash(doc.isObject() ? QJsonValue(doc.object()) : QJsonValue(doc.array()));
+    }
+    reply->deleteLater();
+    return status_code != 0;
+}
+
+QString MiningCenter::extractHash(const QJsonValue& value) const
+{
+    if (value.isObject()) {
+        const QJsonObject obj = value.toObject();
+        for (const QString& key : {QStringLiteral("hash"), QStringLiteral("blockhash")}) {
+            const QJsonValue v = obj.value(key);
+            if (v.isString() && v.toString().size() >= 32) return v.toString();
+        }
+        for (auto it = obj.constBegin(); it != obj.constEnd(); ++it) {
+            const QString found = extractHash(it.value());
+            if (!found.isEmpty()) return found;
+        }
+    } else if (value.isArray()) {
+        for (const QJsonValue& v : value.toArray()) {
+            const QString found = extractHash(v);
+            if (!found.isEmpty()) return found;
+        }
+    }
+    return {};
+}
+
+void MiningCenter::reconnectTrustedPeers()
+{
+    bool ok = false;
+    QString error;
+    // Force a fresh VERSION handshake. This matters because getpeerinfo's
+    // startingheight value is only set at connection time.
+    for (const QString& peer : m_trusted_peers) {
+        UniValue params(UniValue::VARR);
+        params.push_back(peer.toStdString());
+        rpc("disconnectnode", params, &ok, &error);
+    }
+
+    QTimer::singleShot(500, this, [this] {
+        bool add_ok = false;
+        QString add_error;
+        for (const QString& peer : m_trusted_peers) {
+            UniValue params(UniValue::VARR);
+            params.push_back(peer.toStdString());
+            params.push_back("onetry");
+            rpc("addnode", params, &add_ok, &add_error);
+        }
+        appendLog(tr("Trusted peers reconnected for a fresh height handshake."));
+        QTimer::singleShot(1500, this, &MiningCenter::refreshAll);
+    });
+}
+
+bool MiningCenter::isPoolRunning() const
+{
+    QProcess p;
+    p.start(QStringLiteral("pgrep"), {QStringLiteral("-x"), QStringLiteral("ckpool")});
+    if (!p.waitForFinished(1000)) return false;
+    return p.exitStatus() == QProcess::NormalExit && p.exitCode() == 0;
+}
+
+bool MiningCenter::stratumPortOpen() const
+{
+    QTcpSocket socket;
+    socket.connectToHost(QHostAddress::LocalHost, 3333);
+    const bool connected = socket.waitForConnected(250);
+    if (connected) socket.disconnectFromHost();
+    return connected;
+}
+
+QString MiningCenter::readConfigValue(const QString& key) const
+{
+    const QString path = homePath(QStringLiteral("twoore-mainnet/twoore.conf"));
+    QFile file(path);
+    if (!file.open(QIODevice::ReadOnly | QIODevice::Text)) return {};
+    QString last;
+    while (!file.atEnd()) {
+        const QString line = QString::fromUtf8(file.readLine()).trimmed();
+        if (line.startsWith('#') || !line.contains('=')) continue;
+        const int pos = line.indexOf('=');
+        if (line.left(pos).trimmed() == key) last = line.mid(pos + 1).trimmed();
+    }
+    return last;
+}
+
+bool MiningCenter::repairCKPoolConfig(QString* error)
+{
+    QFile input(m_ckpool_conf->text());
+    if (!input.open(QIODevice::ReadOnly)) {
+        if (error) *error = tr("Cannot open CKPool config: %1").arg(m_ckpool_conf->text());
+        return false;
+    }
+    QJsonParseError parse_error;
+    QJsonDocument doc = QJsonDocument::fromJson(input.readAll(), &parse_error);
+    input.close();
+    if (parse_error.error != QJsonParseError::NoError || !doc.isObject()) {
+        if (error) *error = tr("CKPool config is not valid JSON: %1").arg(parse_error.errorString());
+        return false;
+    }
+
+    const QString rpc_user = readConfigValue(QStringLiteral("rpcuser"));
+    const QString rpc_pass = readConfigValue(QStringLiteral("rpcpassword"));
+    if (rpc_user.isEmpty() || rpc_pass.isEmpty()) {
+        if (error) *error = tr("rpcuser/rpcpassword were not found in ~/twoore-mainnet/twoore.conf");
+        return false;
+    }
+
+    QJsonObject root = doc.object();
+    QJsonObject daemon;
+    daemon.insert(QStringLiteral("url"), QStringLiteral("127.0.0.1:8332"));
+    daemon.insert(QStringLiteral("auth"), rpc_user);
+    daemon.insert(QStringLiteral("pass"), rpc_pass);
+    daemon.insert(QStringLiteral("notify"), true);
+    root.insert(QStringLiteral("btcd"), QJsonArray{daemon});
+    root.insert(QStringLiteral("btcsig"), QStringLiteral("/TWOORE-BITAXE/"));
+    root.insert(QStringLiteral("blockpoll"), 100);
+    root.insert(QStringLiteral("donation"), 0.0);
+    root.insert(QStringLiteral("nonce1length"), 4);
+    root.insert(QStringLiteral("nonce2length"), 8);
+    root.insert(QStringLiteral("update_interval"), 5);
+    root.insert(QStringLiteral("version_mask"), QStringLiteral("1fffe000"));
+    root.insert(QStringLiteral("dropidle"), 0);
+    root.insert(QStringLiteral("serverurl"), QJsonArray{QStringLiteral("0.0.0.0:3333")});
+    root.insert(QStringLiteral("mindiff"), 1);
+    root.insert(QStringLiteral("startdiff"), 1);
+    root.insert(QStringLiteral("maxdiff"), 1);
+    root.insert(QStringLiteral("zmqblock"), QStringLiteral("tcp://127.0.0.1:28332"));
+    root.insert(QStringLiteral("logdir"), homePath(QStringLiteral("ckpool-twoore/logs")));
+
+    const QString backup = m_ckpool_conf->text() + QStringLiteral(".bak-") + QDateTime::currentDateTime().toString(QStringLiteral("yyyyMMdd-HHmmss"));
+    QFile::copy(m_ckpool_conf->text(), backup);
+    QSaveFile output(m_ckpool_conf->text());
+    if (!output.open(QIODevice::WriteOnly)) {
+        if (error) *error = tr("Cannot write CKPool config");
+        return false;
+    }
+    output.write(QJsonDocument(root).toJson(QJsonDocument::Indented));
+    if (!output.commit()) {
+        if (error) *error = tr("Cannot commit CKPool config");
+        return false;
+    }
+    return true;
+}
+
+void MiningCenter::startPool()
+{
+    refreshAll();
+    if (!m_safe) {
+        QMessageBox::warning(this, tr("Mining blocked"), tr("CKPool will not start because the local tip is not confirmed by the public network."));
+        appendLog(tr("CKPool start blocked by chain guard."));
+        return;
+    }
+
+    QString error;
+    if (!repairCKPoolConfig(&error)) {
+        QMessageBox::critical(this, tr("CKPool"), error);
+        appendLog(error);
+        return;
+    }
+
+    if (isPoolRunning()) {
+        appendLog(tr("CKPool is already running."));
+        return;
+    }
+
+    const bool launched = QProcess::startDetached(m_ckpool_path->text(), {
+        QStringLiteral("-c"), m_ckpool_conf->text(), QStringLiteral("-D"), QStringLiteral("-l"), QStringLiteral("6")
+    });
+    if (!launched) {
+        QMessageBox::critical(this, tr("CKPool"), tr("Could not launch CKPool."));
+        appendLog(tr("CKPool launch failed."));
+        return;
+    }
+    m_last_safe_height = m_local_blocks;
+    appendLog(tr("CKPool started at confirmed height %1.").arg(m_local_blocks));
+    QTimer::singleShot(1000, this, &MiningCenter::refreshAll);
+}
+
+void MiningCenter::stopPool()
+{
+    if (isPoolRunning()) {
+        QProcess::execute(QStringLiteral("pkill"), {QStringLiteral("-TERM"), QStringLiteral("-x"), QStringLiteral("ckpool")});
+        appendLog(tr("CKPool stopped."));
+    }
+    QTimer::singleShot(250, this, &MiningCenter::refreshAll);
+}
+
+bool MiningCenter::safeRollbackToPublic(QString* error)
+{
+    if (m_peer_height < 0 || m_peer_agree < 3) {
+        if (error) *error = tr("At least 3 trusted peers must agree before rollback.");
+        return false;
+    }
+    if (m_local_blocks <= m_peer_height) {
+        if (error) error->clear();
+        return true;
+    }
+
+    int api_common_code = 0;
+    QString api_common_hash;
+    if (!fetchApiBlockSync(m_peer_height, api_common_code, api_common_hash) || api_common_code != 200 || api_common_hash.isEmpty()) {
+        if (error) *error = tr("The TWOORE API did not confirm the peer common height %1.").arg(m_peer_height);
+        return false;
+    }
+
+    bool ok = false;
+    QString rpc_error;
+    UniValue params(UniValue::VARR);
+    params.push_back(m_peer_height);
+    const UniValue common_hash_v = rpc("getblockhash", params, &ok, &rpc_error);
+    if (!ok || !common_hash_v.isStr()) {
+        if (error) *error = rpc_error;
+        return false;
+    }
+    const QString common_hash = QString::fromStdString(common_hash_v.get_str());
+    if (api_common_hash != common_hash) {
+        if (error) *error = tr("API/peer common-point hash mismatch. Rollback refused.");
+        return false;
+    }
+
+    int api_tip_code = 0;
+    QString api_tip_hash;
+    fetchApiBlockSync(m_local_blocks, api_tip_code, api_tip_hash);
+    if (api_tip_code == 200 && !api_tip_hash.isEmpty() && api_tip_hash == m_local_hash) {
+        if (error) *error = tr("The current local tip is already public. Rollback refused.");
+        return false;
+    }
+
+    UniValue bad_params(UniValue::VARR);
+    bad_params.push_back(m_peer_height + 1);
+    const UniValue bad_hash_v = rpc("getblockhash", bad_params, &ok, &rpc_error);
+    if (!ok || !bad_hash_v.isStr()) {
+        if (error) *error = rpc_error;
+        return false;
+    }
+    const QString bad_hash = QString::fromStdString(bad_hash_v.get_str());
+    UniValue invalidate(UniValue::VARR);
+    invalidate.push_back(bad_hash.toStdString());
+    rpc("invalidateblock", invalidate, &ok, &rpc_error);
+    if (!ok) {
+        if (error) *error = rpc_error;
+        return false;
+    }
+    appendLog(tr("Safely invalidated local branch from height %1 (%2).").arg(m_peer_height + 1).arg(bad_hash));
+    if (error) error->clear();
+    return true;
+}
+
+void MiningCenter::repairNetwork()
+{
+    stopPool();
+    reconnectTrustedPeers();
+    QTimer::singleShot(1800, this, [this] {
+        updateNodeAndPeers();
+        QString error;
+        if (m_local_blocks > m_peer_height && m_peer_agree >= 3) {
+            if (safeRollbackToPublic(&error)) {
+                QMessageBox::information(this, tr("TWOORE"), tr("The node was returned to the verified public common tip."));
+            } else {
+                QMessageBox::warning(this, tr("TWOORE"), error);
+            }
+        } else {
+            QMessageBox::information(this, tr("TWOORE"), tr("No safe rollback is required. The node will continue synchronizing."));
+        }
+        refreshAll();
+    });
+}
+
+void MiningCenter::onBlockTipChanged(int count)
+{
+    if (!isPoolRunning()) return;
+    if (m_last_safe_height >= 0 && count > m_last_safe_height) {
+        m_pending_mined_height = count;
+        m_pending_since_ms = QDateTime::currentMSecsSinceEpoch();
+        m_pending_peers_refreshed = false;
+        appendLog(tr("New locally mined block detected at height %1. CKPool is being stopped until public propagation is confirmed.").arg(count));
+        stopPool();
+        pauseBitaxes();
+        m_pool_was_auto_stopped = true;
+    }
+}
