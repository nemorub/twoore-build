+void MiningCenter::refreshBitaxe(const QString& ip, QLabel* label, int slot)
+{
+    if (ip.isEmpty()) {
+        setStateLabel(label, tr("Enter an IP address"), WARN);
+        return;
+    }
+    QNetworkRequest req(QUrl(QStringLiteral("http://%1/api/system/info").arg(ip)));
+    QNetworkReply* reply = m_network->get(req);
+    QTimer::singleShot(3500, reply, [reply] { if (!reply->isFinished()) reply->abort(); });
+    connect(reply, &QNetworkReply::finished, this, [this, reply, label, slot] {
+        const int status = reply->attribute(QNetworkRequest::HttpStatusCodeAttribute).toInt();
+        if (status != 200) {
+            setStateLabel(label, tr("OFFLINE / HTTP %1").arg(status), BAD);
+            reply->deleteLater();
+            return;
+        }
+        const QJsonDocument doc = QJsonDocument::fromJson(reply->readAll());
+        const QJsonObject o = doc.object();
+        const QString host = o.value(QStringLiteral("hostname")).toString(tr("Bitaxe %1").arg(slot));
+        const double hr = o.value(QStringLiteral("hashRate")).toDouble();
+        const double temp = o.value(QStringLiteral("temp")).toDouble();
+        const double power = o.value(QStringLiteral("power")).toDouble();
+        const int shares = o.value(QStringLiteral("sharesAccepted")).toInt();
+        const QString best = o.value(QStringLiteral("bestDiff")).toVariant().toString();
+        const QString pool = o.value(QStringLiteral("stratumURL")).toString();
+        setStateLabel(label,
+            tr("%1 · %2 GH/s · %3°C · %4 W · shares %5 · best %6 · %7")
+                .arg(host).arg(hr, 0, 'f', 1).arg(temp, 0, 'f', 1).arg(power, 0, 'f', 1).arg(shares).arg(best).arg(pool),
+            GOOD);
+        reply->deleteLater();
+    });
+}
+
+void MiningCenter::configureBitaxe1() { configureBitaxe(m_bitaxe1_ip->text().trimmed(), QStringLiteral("bitaxe1"), m_bitaxe1_state); }
+void MiningCenter::configureBitaxe2() { configureBitaxe(m_bitaxe2_ip->text().trimmed(), QStringLiteral("bitaxe2"), m_bitaxe2_state); }
+
+void MiningCenter::configureBitaxe(const QString& ip, const QString& worker, QLabel* label)
+{
+    if (ip.isEmpty() || m_stratum_host->text().trimmed().isEmpty()) {
+        QMessageBox::warning(this, tr("Bitaxe"), tr("Enter the Bitaxe IP and the Stratum host visible from your LAN."));
+        return;
+    }
+    if (!m_safe) {
+        QMessageBox::warning(this, tr("Bitaxe"), tr("The node is not on a confirmed public tip. Configuration is allowed, but mining will remain blocked until the network is safe."));
+    }
+
+    QJsonObject settings;
+    settings.insert(QStringLiteral("stratumURL"), QStringLiteral("stratum+tcp://") + m_stratum_host->text().trimmed());
+    settings.insert(QStringLiteral("stratumPort"), 3333);
+    settings.insert(QStringLiteral("stratumUser"), worker);
+    settings.insert(QStringLiteral("stratumPassword"), QStringLiteral("x"));
+    settings.insert(QStringLiteral("stratumProtocol"), QStringLiteral("SV1"));
+    settings.insert(QStringLiteral("stratumSuggestedDifficulty"), 1.0);
+    settings.insert(QStringLiteral("stratumTLS"), 0);
+
+    QNetworkRequest req(QUrl(QStringLiteral("http://%1/api/system").arg(ip)));
+    req.setHeader(QNetworkRequest::ContentTypeHeader, QStringLiteral("application/json"));
+    QNetworkReply* reply = m_network->sendCustomRequest(req, QByteArrayLiteral("PATCH"), QJsonDocument(settings).toJson(QJsonDocument::Compact));
+    QTimer::singleShot(4000, reply, [reply] { if (!reply->isFinished()) reply->abort(); });
+    connect(reply, &QNetworkReply::finished, this, [this, reply, label, worker, ip] {
+        const int status = reply->attribute(QNetworkRequest::HttpStatusCodeAttribute).toInt();
+        if (status == 200) {
+            setStateLabel(label, tr("LINKED: %1 → %2:3333").arg(worker).arg(m_stratum_host->text().trimmed()), GOOD);
+            appendLog(tr("%1 (%2) linked to TWOORE Stratum.").arg(worker).arg(ip));
+        } else {
+            setStateLabel(label, tr("Configuration failed (HTTP %1)").arg(status), BAD);
+            appendLog(tr("Bitaxe configuration failed for %1 (HTTP %2).").arg(ip).arg(status));
+        }
+        reply->deleteLater();
+    });
+}
+
+void MiningCenter::bitaxePost(const QString& ip, const QString& path, QLabel* label, const QString& action_name)
+{
+    if (ip.trimmed().isEmpty()) return;
+    QNetworkRequest req(QUrl(QStringLiteral("http://%1%2").arg(ip.trimmed()).arg(path)));
+    QNetworkReply* reply = m_network->post(req, QByteArray());
+    QTimer::singleShot(3000, reply, [reply] { if (!reply->isFinished()) reply->abort(); });
+    connect(reply, &QNetworkReply::finished, this, [this, reply, label, action_name, ip] {
+        const int status = reply->attribute(QNetworkRequest::HttpStatusCodeAttribute).toInt();
+        if (status == 200) {
+            setStateLabel(label, action_name, GOOD);
+            appendLog(tr("Bitaxe %1: %2").arg(ip).arg(action_name));
+        }
+        reply->deleteLater();
+    });
+}
+
+void MiningCenter::pauseBitaxes()
+{
+    bitaxePost(m_bitaxe1_ip->text(), QStringLiteral("/api/system/pause"), m_bitaxe1_state, tr("PAUSED"));
+    bitaxePost(m_bitaxe2_ip->text(), QStringLiteral("/api/system/pause"), m_bitaxe2_state, tr("PAUSED"));
+}
+
+void MiningCenter::resumeBitaxes()
+{
+    if (!m_safe || !isPoolRunning()) {
+        QMessageBox::warning(this, tr("Bitaxe"), tr("Resume is blocked until the public chain is confirmed and CKPool is running."));
+        return;
+    }
+    bitaxePost(m_bitaxe1_ip->text(), QStringLiteral("/api/system/resume"), m_bitaxe1_state, tr("MINING"));
+    bitaxePost(m_bitaxe2_ip->text(), QStringLiteral("/api/system/resume"), m_bitaxe2_state, tr("MINING"));
+}
