+void MiningCenter::appendLog(const QString& text)
+{
+    if (!m_log) return;
+    m_log->append(QStringLiteral("[%1] %2").arg(QDateTime::currentDateTime().toString(QStringLiteral("HH:mm:ss")), text));
+}
